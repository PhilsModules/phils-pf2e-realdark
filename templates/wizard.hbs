<div class="realdark-wizard-container">
    <div class="realdark-wizard-left">
        <div class="rd-header-panel">
            <h1 class="rd-title">{{localize 'REALDARK.Wizard.Title'}}</h1>
            <div class="rd-subtitle">{{localize 'REALDARK.Wizard.Subtitle'}}</div>
        </div>

        <div class="rd-form-body">
            <div class="rd-section-title" style="margin-top:0;">{{localize 'REALDARK.Wizard.Section.Presets'}}</div>

            <div class="rd-preset-grid">
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="paper">{{localize 'REALDARK.Preset.Paper'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="leather">{{localize 'REALDARK.Preset.Leather'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="wood">{{localize 'REALDARK.Preset.Wood'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="stone">{{localize 'REALDARK.Preset.Stone'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="bamboo">{{localize 'REALDARK.Preset.Bamboo'}}</div>

                <div class="rd-preset-btn" data-action="applyPreset" data-preset="ebony">{{localize 'REALDARK.Preset.Ebony'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="obsidian">{{localize 'REALDARK.Preset.Obsidian'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="velvet">{{localize 'REALDARK.Preset.Velvet'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="relic">{{localize 'REALDARK.Preset.Relic'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="ore">{{localize 'REALDARK.Preset.Ore'}}</div>

                <div class="rd-preset-btn" data-action="applyPreset" data-preset="inferno">{{localize 'REALDARK.Preset.Inferno'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="crimson">{{localize 'REALDARK.Preset.Crimson'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="roses">{{localize 'REALDARK.Preset.Roses'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="dragon">{{localize 'REALDARK.Preset.Dragon'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="ritual">{{localize 'REALDARK.Preset.Ritual'}}</div>

                <div class="rd-preset-btn" data-action="applyPreset" data-preset="frost">{{localize 'REALDARK.Preset.Frost'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="moon">{{localize 'REALDARK.Preset.Moon'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="celestial">{{localize 'REALDARK.Preset.Celestial'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="mystic">{{localize 'REALDARK.Preset.Mystic'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="ethereal">{{localize 'REALDARK.Preset.Ethereal'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="perry">{{localize 'REALDARK.Preset.Perry'}}</div>

                <div class="rd-preset-btn" data-action="applyPreset" data-preset="moss">{{localize 'REALDARK.Preset.Moss'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="venom">{{localize 'REALDARK.Preset.Venom'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="swamp">{{localize 'REALDARK.Preset.Swamp'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="croc">{{localize 'REALDARK.Preset.Croc'}}</div>

                <div class="rd-preset-btn" data-action="applyPreset" data-preset="shadow_star">{{localize 'REALDARK.Preset.ShadowStar'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="shadowwing">{{localize 'REALDARK.Preset.Shadowwing'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="weave">{{localize 'REALDARK.Preset.Weave'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="stars">{{localize 'REALDARK.Preset.Stars'}}</div>
                <div class="rd-preset-btn" data-action="applyPreset" data-preset="void">{{localize 'REALDARK.Preset.Void'}}</div>
            </div>

            <div class="rd-section-title">{{localize 'REALDARK.Wizard.Section.Colors'}}</div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.BgColor'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorBackground" value="{{bgVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{bgVal}}">
                        <input type="color" name="colorBackgroundPicker" value="{{bgVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Banner'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorBanner" value="{{bannerVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{bannerVal}}">
                        <input type="color" name="colorBannerPicker" value="{{bannerVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Primary'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorPrimary" value="{{primaryVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{primaryVal}}">
                        <input type="color" name="colorPrimaryPicker" value="{{primaryVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Secondary'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorSecondary" value="{{secondaryVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{secondaryVal}}">
                        <input type="color" name="colorSecondaryPicker" value="{{secondaryVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Accent'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorAccent" value="{{accentVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{accentVal}}">
                        <input type="color" name="colorAccentPicker" value="{{accentVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Whisper'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorWhisper" value="{{whisperVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{whisperVal}}">
                        <input type="color" name="colorWhisperPicker" value="{{whisperVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Blind'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorBlind" value="{{blindVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{blindVal}}">
                        <input type="color" name="colorBlindPicker" value="{{blindVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.DiceText'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorDiceText" value="{{diceVal}}" class="rd-hex-input" placeholder="{{localize 'REALDARK.Wizard.Placeholder.Auto'}}">
                    <div class="rd-swatch" style="background: {{diceValPicker}}">
                        <input type="color" name="colorDiceTextPicker" value="{{diceValPicker}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.Text'}}</span>
                <div class="rd-input-wrapper">
                    <input type="text" name="colorText" value="{{textVal}}" class="rd-hex-input">
                    <div class="rd-swatch" style="background: {{textVal}}">
                        <input type="color" name="colorTextPicker" value="{{textVal}}">
                    </div>
                </div>
            </div>

            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.OverrideSkillColor'}}</span>
                <input type="checkbox" name="overrideSkillColor" {{checked toggleSkillColor}}>
            </div>

            <div class="rd-section-title">{{localize 'REALDARK.Wizard.Section.Opacity'}}</div>

            <div class="rd-control-group" style="display:block;">
                <div style="display:flex; justify-content:space-between; font-size:0.9em;">
                    <span>{{localize 'REALDARK.Wizard.Label.SidebarOpacity'}}</span>
                    <span id="rd-sidebar-op-val">{{sidebarOpVal}}</span>
                </div>
                <input type="range" name="sidebarOpacity" min="0" max="1" step="0.05" value="{{sidebarOpVal}}" style="width:100%; margin-top:5px;">
            </div>

            <div class="rd-control-group" style="display:block;">
                <div style="display:flex; justify-content:space-between; font-size:0.9em;">
                    <span>{{localize 'REALDARK.Wizard.Label.InputDarkness'}}</span>
                    <span id="rd-slider-val">{{sliderVal}}</span>
                </div>
                <input type="range" id="rd-input-darkness-range" min="0" max="1" step="0.05" value="{{sliderVal}}" style="width:100%; margin-top:5px;">
                <input type="hidden" name="inputBg" id="inputBgHidden" value="{{inputVal}}">
            </div>

            <div class="rd-section-title">{{localize 'REALDARK.Wizard.Section.Scopes'}}</div>
            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.ScopeActor'}}</span>
                <input type="checkbox" name="themeEnabledActor" {{checked toggleActor}}>
            </div>
            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.ScopeItem'}}</span>
                <input type="checkbox" name="themeEnabledItem" {{checked toggleItem}}>
            </div>
            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.ScopeJournal'}}</span>
                <input type="checkbox" name="themeEnabledJournal" {{checked toggleJournal}}>
            </div>
            <div class="rd-control-group">
                <span class="rd-label-main">{{localize 'REALDARK.Wizard.Label.ScopeChat'}}</span>
                <input type="checkbox" name="themeEnabledChat" {{checked toggleChat}}>
            </div>

            <input type="hidden" name="backgroundImage" value="{{bgImgVal}}">
            <input type="hidden" name="bgSize" value="{{bgSizeVal}}">
        </div>

        <div class="rd-footer">
            <button type="submit" class="rd-submit-btn">{{localize 'REALDARK.Wizard.Button.Save'}}</button>
        </div>
    </div>

    <div class="realdark-wizard-right">
        <div class="rd-preview-sheet">
            <div class="rd-preview-sidebar">
                <img src="modules/phils-pf2e-realdark/assets/Logo.webp" style="width:100%; margin-bottom: 20px;">
                <div style="width:40px; height:40px; border-radius:50%; border: 1px solid rgba(255,255,255,0.2); background:var(--realdark-input-bg); display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-dice-d20" style="color:var(--realdark-primary);"></i>
                </div>
                <div style="width:40px; height:40px; border-radius:50%; border: 1px solid rgba(255,255,255,0.2); background:var(--realdark-input-bg); display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-suitcase" style="color:var(--realdark-primary);"></i>
                </div>
                <div style="text-align:center; margin-top:auto;">
                    <div style="font-size:0.8em; color:var(--realdark-accent);">{{localize 'REALDARK.Wizard.Preview.HP'}}</div>
                    <div style="font-size:1.2em; font-weight:bold;">42</div>
                </div>
            </div>

            <div class="rd-preview-content">
                <div class="rd-preview-header">
                    Valeros
                    <span style="float:right; font-size:0.6em; opacity:0.5; margin-top:10px;">{{localize 'REALDARK.Wizard.Preview.Level'}} 1</span>
                </div>

                <div style="display:flex; gap:10px;">
                    <input type="text" class="rd-preview-input" value="{{localize 'REALDARK.Wizard.Preview.Human'}}" readonly>
                    <input type="text" class="rd-preview-input" value="{{localize 'REALDARK.Wizard.Preview.Fighter'}}" readonly>
                </div>

                <div class="rd-preview-box">
                    <div style="font-weight:bold; margin-bottom:5px; color:var(--realdark-primary);">{{localize 'REALDARK.Wizard.Preview.Attributes'}}</div>
                    <div style="display:flex; justify-content:space-between; text-align:center;">
                        <div>
                            <div style="font-size:0.8em; opacity:0.7;">STR</div>
                            <div style="font-weight:bold;">+4</div>
                        </div>
                        <div>
                            <div style="font-size:0.8em; opacity:0.7;">DEX</div>
                            <div style="font-weight:bold;">+2</div>
                        </div>
                        <div>
                            <div style="font-size:0.8em; opacity:0.7;">CON</div>
                            <div style="font-weight:bold;">+3</div>
                        </div>
                        <div>
                            <div style="font-size:0.8em; opacity:0.7;">INT</div>
                            <div style="font-weight:bold;">+0</div>
                        </div>
                        <div>
                            <div style="font-size:0.8em; opacity:0.7;">WIS</div>
                            <div style="font-weight:bold;">+1</div>
                        </div>
                    </div>
                </div>

                <div style="flex:1;">
                    <div style="font-weight:bold; margin-bottom:5px; color:var(--realdark-primary);">{{localize 'REALDARK.Wizard.Preview.Inventory'}}</div>
                    <div style="display:flex; justify-content:space-between; border-bottom:1px solid rgba(130,130,130,0.3); padding:4px;">
                        <span>{{localize 'REALDARK.Wizard.Preview.Longsword'}}</span>
                        <span>1</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; border-bottom:1px solid rgba(130,130,130,0.3); padding:4px;">
                        <span>{{localize 'REALDARK.Wizard.Preview.Shield'}}</span>
                        <span>1</span>
                    </div>
                </div>
            </div>
        </div>

        <div style="position:absolute; bottom:10px; right:10px; opacity:0.3; font-size:0.8em;">{{localize 'REALDARK.Wizard.Preview.Live'}}</div>
    </div>
</div>